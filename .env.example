# Ring, every setting (docs/SPEC.md section 15.3). Copy to .env or set them in the
# service environment; Ring reads process.env only (no dotenv). Unset means the default.

# The server's permanent origin, https in production. Every actor and post URL embeds it,
# and once the server has federated it can never change (spec 15.2).
# Unset in development: the request's own origin is used.
PUBLIC_ORIGIN=

# Required. Signs the session cookie. In production: 32+ characters with real entropy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The first account's email: its signup needs no invite and becomes admin.
# After that it grants nothing. Required in production.
ADMIN_EMAIL=

# The one data directory: JSON files, images, keys, sessions. Keep it on a persistent disk.
DATA_DIR=./data

PORT=3000

# Which peer is the reverse proxy (Caddy, nginx, Render). REQUIRED in production: without
# it the Secure session cookie is never set and every client shares one rate-limit bucket.
# Best: the proxy's address, so a client reaching the app port directly cannot spoof
# X-Forwarded-For: loopback (proxy on the same box), or an address or CIDR list.
# A hop count (1) believes any peer: only when the app port is unreachable from outside.
TRUST_PROXY=

# invite (default): a live invite is needed to sign up. open: anyone may.
SIGNUP=invite
# Live invites each member may hold.
INVITES_PER_MEMBER=5

# off (default). on mounts the ActivityPub routes and starts delivery. It needs PUBLIC_ORIGIN:
# https, the default port, a domain you will keep forever. The first delivery or verified inbound
# activity makes that origin permanent: this data dir then refuses to boot under any other.
# Never under a provider's default host (*.onrender.com), a tunnel or a bare IP: refused.
FEDERATION=off
# 1 (default): outboxes, collections and posts answer only signed GETs. 0 serves them unsigned.
AUTHORIZED_FETCH=1

# smtp, resend or log. log (the default outside production) writes each mail to the
# server log and DATA_DIR/mail-outbox.jsonl (kept 24 hours), and the admin passes the
# link on. smtp and resend need PUBLIC_ORIGIN: mailed links never come from a Host header.
# Unset in production: signup and password reset answer 503 mail_unavailable.
MAIL_PROVIDER=
# smtp: a nodemailer SMTP URL, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
# resend: an API key (sent over fetch, no package)
RESEND_API_KEY=
# The From address. Default: Ring <ring@<host of PUBLIC_ORIGIN>>
MAIL_FROM=

# The server's name in NodeInfo. Default: the host.
NODE_NAME=

# Per-member image storage, in MB.
MEMBER_STORAGE_MB=500

# Production mode: Secure cookies, and the settings above become required.
NODE_ENV=

# Later phases (read and documented now, used from the phase named):
# REMOTE_MEDIA_MB=2048        remote media cache cap (P6)
# BLOCKED_DOMAINS=            comma list, the P6 stopgap until /admin (P8)
# RING_RESET_DISABLED=        test hook (P2)
# FED_TEST_LOOPBACK=          test hook: the fetcher allows http and loopback (loopback only); refused in
#                             production, and unless PUBLIC_ORIGIN is itself on loopback
