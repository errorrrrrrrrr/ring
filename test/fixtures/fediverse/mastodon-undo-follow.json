{
  "note": "The shape Mastodon 4.x sends to undo a Follow (app/serializers/activitypub/undo_follow_serializer.rb). Hosts are placeholders the tests replace.",
  "signed_headers": ["(request-target)", "host", "date", "digest", "content-type"],
  "content_type": "application/activity+json",
  "body": {
    "@context": "https://www.w3.org/ns/activitystreams",
    "id": "https://mastodon.example/users/bob#follows/1234/undo",
    "type": "Undo",
    "actor": "https://mastodon.example/users/bob",
    "object": {
      "id": "https://mastodon.example/8f3a1c2e-5b7d-4e9f-a0b1-c2d3e4f5a6b7",
      "type": "Follow",
      "actor": "https://mastodon.example/users/bob",
      "object": "https://ring.example/users/ana"
    }
  }
}
